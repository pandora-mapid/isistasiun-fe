# Salin ke /opt/isistasiun-fe/.env di server, lalu sesuaikan seperlunya.
# Workflow deploy TIDAK menimpa berkas ini — ia hanya menulis ulang satu baris
# IMAGE_TAG di `.env` setiap kali deploy.
#
# Berbeda dari backend, di sini tidak ada rahasia apa pun: seluruh nilai
# NEXT_PUBLIC_* memang ikut terkirim ke browser.

# ---- identitas deploy ----
# Menentukan nama container di shared-web-net, jadi harus cocok dengan
# upstream yang dipakai nginx: ${COMPOSE_PROJECT_NAME}-frontend-1:3000
COMPOSE_PROJECT_NAME=isistasiun-fe-dev

# Ditimpa otomatis oleh setiap deploy menjadi development-<short_sha>.
# Nilai di bawah cuma titik awal saat pertama kali menyalakan stack.
IMAGE_TAG=development

# ---- alamat backend ----
# ⚠️ DIBACA SAAT BUILD, BUKAN SAAT RUNTIME.
#
# Next.js menyisipkan nilai NEXT_PUBLIC_* ke dalam bundel JavaScript ketika
# image dibangun. Mengubahnya di sini TIDAK mengubah perilaku aplikasi —
# yang berlaku adalah nilai yang dipakai CI waktu membangun image (lihat
# .github/workflows/ci.yml, langkah "Tentukan environment").
#
# Keduanya dicantumkan di sini sebagai catatan: inilah nilai yang seharusnya
# ada di dalam image bertag `development`. Kalau perlu diubah, ubah di CI lalu
# build ulang.
#
# Nama variabelnya `NEXT_PUBLIC_API_BASE_URL` (bukan ..._API_URL) — itu yang
# dibaca lib/data/source.ts, dan nilainya harus sudah termasuk `/api/v1`.
NEXT_PUBLIC_API_BASE_URL=https://api.dev.isistasiun.trackster.cloud/api/v1

# Alamat style basemap. Di produksi menunjuk ke PROXY backend, bukan langsung
# ke MAPID — kunci MAPID dipegang backend. Kalau dikosongkan, aplikasi jatuh
# ke OpenFreeMap Liberty (lihat lib/map/config.ts).
NEXT_PUBLIC_BASEMAP_URL=https://api.dev.isistasiun.trackster.cloud/api/v1/basemap/style.json
