# Variabel lingkungan frontend — salin ke `.env.local` lalu isi seperlunya.
#
# `.env.local` sudah diabaikan git secara bawaan oleh Next.js. Berkas ini yang
# dikomit, sebagai daftar apa saja yang perlu diisi.
#
# CATATAN: awalan NEXT_PUBLIC_ berarti nilainya DISISIPKAN KE BUNDEL BROWSER
# dan bisa dibaca siapa pun. Jangan pernah menaruh rahasia di sini. Kunci
# MAPID tidak ada di daftar ini justru karena itu — ia dipegang backend, dan
# browser menembak proxy (ROADMAP §4.4).

# Alamat sumber data.
#   kosong  -> "/mock", data contoh yang ikut di repo (Fase 0-1)
#   Fase 2  -> https://api.contoh.id/api/v1
# Nilai ini juga dipakai login/premium. Backend harus mengizinkan origin FE
# dan credentials agar cookie refresh HttpOnly dapat dikirim.
NEXT_PUBLIC_API_BASE_URL=

# Alamat style basemap yang dibaca MapLibre.
#   kosong    -> OpenFreeMap Liberty, basemap sementara
#   produksi  -> alamat PROXY backend, mis. https://api.contoh.id/api/v1/basemap/style.json
#   lokal     -> boleh diarahkan langsung ke MAPID supaya /peta tetap bisa
#                dibuka saat backend belum jalan
#
# Kalau diarahkan ke proxy, backend WAJIB menulis ulang field `glyphs`,
# `sprite`, dan `sources.*.tiles` di dalam style.json. Kalau tidak, browser
# tetap menembak MAPID tanpa key dan peta dasar kosong tanpa pesan error.
NEXT_PUBLIC_BASEMAP_URL=
NEXT_PUBLIC_BASEMAP_SATELLITE_URL=
NEXT_PUBLIC_BASEMAP_BUILDING_URL=
